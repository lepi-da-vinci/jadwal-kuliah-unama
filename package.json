{
  "name": "jadwal-kuliah-unama",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:api": "bun --filter '@jadwal/api' dev",
    "dev:web": "bun --filter '@jadwal/web' dev",
    "start:api": "bun --filter '@jadwal/api' start",
    "scrape:test": "bun run --cwd apps/scrapper test",
    "scrape:sync": "bun run --cwd apps/scrapper sync",
    "scrape:fresh": "bun run --cwd apps/scrapper sync:fresh",
    "db:push": "bun run --cwd packages/db db:push",
    "db:studio": "bun run --cwd packages/db db:studio",
    "tsc": "bun --cwd apps/web tsc --noEmit",
    "tsc:all": "bun --filter '*' tsc --noEmit"
  }
}
